# AIOne Odoo Solution Builder — environment variable names
#
# This file documents NAMES ONLY. Never commit a populated .env or .env.local.
# Values belong in .env.local or the approved secret provider (ADR-010).
#
# Two hard rules, enforced in review:
#   1. Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Never put a
#      credential behind that prefix.
#   2. Per ADR-014 the web tier holds a session and nothing else. It must not
#      receive a database URL, a service-role key or a storage credential.

# ---------------------------------------------------------------------------
# Browser-exposed — web tier, safe to ship to the client
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=he-IL
NEXT_PUBLIC_SECONDARY_LOCALE=en-US
NEXT_PUBLIC_AUTH_PROVIDER_URL=
NEXT_PUBLIC_AUTH_PUBLISHABLE_KEY=

# BCP-47 above is the presentation form. Contracts, storage and Odoo use the
# canonical he_IL / en_US per ADR-015.

# ---------------------------------------------------------------------------
# Web tier — server only
# ---------------------------------------------------------------------------
DOMAIN_API_BASE_URL=http://localhost:8000
DOMAIN_API_SERVICE_AUDIENCE=aione.domain-api
SESSION_COOKIE_SECRET=

# Local development substitute for workload identity (ADR-014). Never set in
# any deployed environment; deployed callers mint short-lived signed tokens.
DOMAIN_API_DEV_TOKEN=

# ---------------------------------------------------------------------------
# Identity provider
# ---------------------------------------------------------------------------
AUTH_ISSUER_URL=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_STEP_UP_MAX_AGE_SECONDS=300

# ---------------------------------------------------------------------------
# Control database — API and worker only (ADR-003, ADR-014)
# ---------------------------------------------------------------------------
# app_api and app_worker are non-superuser, non-BYPASSRLS roles.
DATABASE_URL_API=
DATABASE_URL_WORKER=
# Migration and break-glass only. Absent from API and worker runtime config.
DATABASE_URL_MIGRATOR=

# ---------------------------------------------------------------------------
# Queue transport — durable state stays in PostgreSQL (ADR-005)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
EVIDENCE_STORAGE_BUCKET=
ARTIFACT_STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_GRANT_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# AI gateway — provider-neutral (ADR-006)
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_PROJECT_ID=
AI_MODEL_DISCOVERY=
AI_MODEL_BLUEPRINT=
AI_GATEWAY_ENABLED=false
AI_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Job authorization and secrets (ADR-010)
# ---------------------------------------------------------------------------
JOB_ENVELOPE_SIGNING_KEY_REF=
JOB_ENVELOPE_MAX_AGE_SECONDS=300
SECRET_PROVIDER=
SECRET_PROVIDER_NAMESPACE=

# ---------------------------------------------------------------------------
# Evidence processing (ADR-012)
# ---------------------------------------------------------------------------
EVIDENCE_SCANNER_ENDPOINT=
EVIDENCE_MAX_UPLOAD_BYTES=

# ---------------------------------------------------------------------------
# Odoo source and Foundation workspace paths — read only, never modified
# ---------------------------------------------------------------------------
ODOO_CORE_PATH=
ODOO_ENTERPRISE_PATH=
ODOO_FOUNDATION_PATH=
AIONE_ADDONS_PATH=

# ---------------------------------------------------------------------------
# Sandbox driver (ADR-008)
# ---------------------------------------------------------------------------
SANDBOX_DRIVER=docker
SANDBOX_NETWORK=
SANDBOX_BASE_DOMAIN=
SANDBOX_ARTIFACT_ROOT=

# ---------------------------------------------------------------------------
# Local development conveniences
# ---------------------------------------------------------------------------
MAIL_CAPTURE_URL=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
